# shellcheck shell=sh
# site.env.example: the cluster-specific values of the launch scripts.
#
# Copy this file to site.env beside it and fill in your own values; nothing reads site.env.example itself.
# site.env is untracked, so the tracked scripts name no cluster, host, user or account.
#
# deploy.sh, submit.sh, pull.sh, run_phase.sh and prewarm_figures.sh source site.env from their own directory when it is there.
# Every assignment keeps a value that is already in the environment, so an exported TC_HPC_* wins over the file and a command-line option wins over both.
# deploy.sh sends site.env to the cluster with the rest of scripts/, which is how submit.sh and run_phase.sh see these values there.
#
# The connection itself is not configured here.
# TC_HPC_HOST is an ssh alias: the host name, the user name and any VPN or jump host belong in ~/.ssh/config, not in this repository.

TC_HPC_HOST="${TC_HPC_HOST:-your-cluster-alias}"              # ssh alias of the login node
TC_HPC_ACCOUNT="${TC_HPC_ACCOUNT:-your-account}"              # sbatch --account
TC_HPC_PARTITION="${TC_HPC_PARTITION:-your-partition}"        # sbatch --partition
TC_HPC_QOS="${TC_HPC_QOS:-your-qos}"                          # sbatch --qos
TC_HPC_MATLAB_MODULE="${TC_HPC_MATLAB_MODULE:-matlab/R2025b}" # module load <this>
TC_HPC_BASE="${TC_HPC_BASE:-~/tcopula}"                       # remote base directory
TC_HPC_CPUS="${TC_HPC_CPUS:-64}"                              # sbatch --cpus-per-task (logical CPUs; hyperthreads count)
TC_HPC_WORKERS="${TC_HPC_WORKERS:-63}"                        # TC_WORKERS inside the job
TC_HPC_MEM="${TC_HPC_MEM:-240G}"                              # sbatch --mem
TC_HPC_TIME="${TC_HPC_TIME:-7-00:00:00}"                      # sbatch --time
TC_HPC_MAX_JOBS="${TC_HPC_MAX_JOBS:-8}"                       # jobs the QOS runs at once; informational
TC_HPC_UV_PYTHON="${TC_HPC_UV_PYTHON:-3.12}"                  # the uv-managed interpreter of the figure renderers (prewarm_figures.sh installs it)
TC_HPC_MODULE_PREREQS="${TC_HPC_MODULE_PREREQS:-}"            # optional: modules to load before the MATLAB module (space separated)
TC_HPC_SBATCH_EXTRA="${TC_HPC_SBATCH_EXTRA:-}"                # optional extra sbatch options, e.g. --hint=nomultithread for one worker per physical core
